#!/bin/sh
# Xvfb wrapper — self-contained Ubuntu noble arm64 userland under /opt/containers/xvfb.
XR=/opt/containers/xvfb/root
export LD_LIBRARY_PATH=$XR/usr/lib/aarch64-linux-gnu:$XR/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export XKB_CONFIG_ROOT=$XR/usr/share/X11/xkb
export XLOCALEDIR=$XR/usr/share/X11/locale
exec $XR/usr/bin/Xvfb "$@"
