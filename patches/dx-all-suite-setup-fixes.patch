From ab15cef68e3e55ce1b0bf725fe3ec8c8fa1d05dd Mon Sep 17 00:00:00 2001
From: Dvir <dvir.chakim@gmail.com>
Date: Sun, 8 Nov 2026 14:04:44 +0200
Subject: [PATCH 4/4] fix(stream): resolve v4l2 device symlinks in CRU media
 lookup

Video indices are unstable across boots (UVC may probe before CRU), so
users will pick /dev/v4l/by-path or by-id names. Compare realpaths when
matching a v4l2src device to its media topology's CRU output node.
---
 dx-ai-studio/dx_stream/core/pipeline.py | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/dx-ai-studio/dx_stream/core/pipeline.py b/dx-ai-studio/dx_stream/core/pipeline.py
index a1cc8af..c5389ab 100644
--- a/dx-ai-studio/dx_stream/core/pipeline.py
+++ b/dx-ai-studio/dx_stream/core/pipeline.py
@@ -54,13 +54,20 @@ _CRU_DEFAULT_SIZE = (1920, 1080)
 
 
 def _cru_media_for(dev_node: str) -> str | None:
-    """Return the /dev/mediaX whose 'CRU output' entity is `dev_node`, else None."""
+    """Return the /dev/mediaX whose 'CRU output' entity is `dev_node`, else None.
+    dev_node may be a /dev/videoN node or a /dev/v4l/by-{path,id} symlink —
+    video indices are unstable across boots, so resolve symlinks first."""
+    try:
+        real = os.path.realpath(dev_node)
+    except Exception:
+        real = dev_node
     for mp in sorted(Path("/dev").glob("media*")):
         try:
             r = subprocess.run(
                 ["media-ctl", "-d", str(mp), "-e", "CRU output"],
                 capture_output=True, text=True, timeout=5)
-            if r.returncode == 0 and r.stdout.strip().split()[:1] == [dev_node]:
+            node = r.stdout.strip().split()[0] if r.stdout.strip() else ""
+            if r.returncode == 0 and node and os.path.realpath(node) == real:
                 return str(mp)
         except Exception:
             continue
-- 
