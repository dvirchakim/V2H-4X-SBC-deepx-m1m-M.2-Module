From 9673ee93651620d0fbcf7dd65b579ca24efe2d1a Mon Sep 17 00:00:00 2001
From: Dvir <dvir.chakim@gmail.com>
Date: Thu, 5 Nov 2026 21:26:02 +0200
Subject: [PATCH 1/2] fix(studio): report installed runtime version and judge
 demo steps by demo_ok

On the iMDT V2H + DX-M1M demonstration image the Setup page misreported
installed state in two places:

- versions.dx_runtime read the umbrella dx-runtime/release.ver (source
  snapshot v2.5.0) while the installed DX-RT component is v3.5.0. Now
  reads dx_rt/release.ver, matching dx-rt-deps and get_sysinfo().
- dx-app-build/dx-app-setup were painted todo unless the FULL contract
  was met (all 497 zoo models ~45GB) even though their Quick Start run
  form is demo-only (build.sh --minimal / asset_setup --demo). The list
  now judges these steps by demo_ok, same as quick_start_plan().

Generated with [Devin](https://devin.ai)

Co-Authored-By: Devin <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 dx-ai-studio/dx_app/core/setup_steps.py | 5 ++++-
 dx-ai-studio/dx_app/static/js/setup.js  | 6 +++++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/dx-ai-studio/dx_app/core/setup_steps.py b/dx-ai-studio/dx_app/core/setup_steps.py
index 94efc85..f800845 100644
--- a/dx-ai-studio/dx_app/core/setup_steps.py
+++ b/dx-ai-studio/dx_app/core/setup_steps.py
@@ -343,7 +343,10 @@ def setup_status():
         r["inference-venv"]={"ok":False,"detail":f"probe failed: {_e}"}
     r["versions"] = {
         "dx_app": _read_release_ver("release.ver"),
-        "dx_runtime": _read_release_ver(str(DX_RT_ROOT.parent / "release.ver")),
+        # dx_runtime = installed DX-RT component version (dx_rt/release.ver), same
+        # marker the dx-rt-deps check and get_sysinfo()'s dx_rt_version read — not
+        # the umbrella dx-runtime repo release.ver, which tracks the source snapshot.
+        "dx_runtime": _read_release_ver(str(DX_RT_ROOT / "release.ver")),
         "npu_driver": _get_npu_driver_version(),
         "compiler": _dxcom_version() or '--',
         "kernel": platform.release(),
diff --git a/dx-ai-studio/dx_app/static/js/setup.js b/dx-ai-studio/dx_app/static/js/setup.js
index 67f5b7e..e1c2d6d 100644
--- a/dx-ai-studio/dx_app/static/js/setup.js
+++ b/dx-ai-studio/dx_app/static/js/setup.js
@@ -103,7 +103,11 @@ async function setupCheckAll(){
       /* Facts (s.detail) show as chips in the row; the line below holds only other words (just completed). */
       if(det)det.textContent=(locallyDone&&!s.ok)?_T5('방금 완료됨','Completed just now','完了したばかり','刚刚完成','剛剛完成','Completado ahora mismo'):'';
       /* Badge, next step and bar are painted by the shared step list (shared/static/dx-steps.js). One row holds short facts only. */
-      _setupStepState(id,(s.ok||locallyDone)?'done':'todo',_setupFacts(s.detail));
+      /* Demo-form steps are judged by demo_ok (same as quick_start_plan / _DEMO_FORM_STEPS):
+         their run form is build.sh --minimal / asset_setup --demo, so the full contract
+         (e.g. all 497 zoo models) is not the promise the demo setup page makes. */
+      var _ok=(id==='dx-app-build'||id==='dx-app-setup')?(s.demo_ok!==undefined?s.demo_ok:s.ok):s.ok;
+      _setupStepState(id,(_ok||locallyDone)?'done':'todo',_setupFacts(s.detail));
       /* Present files without a Studio record are installed but unverified: offer Verify
          (the same step checks each file's size against the server and keeps a matching one). */
       if(id==='dx-app-setup'){
-- 
