FROM ubuntu:24.04
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
    g++ cmake ninja-build pkg-config python3-dev python3-venv python3-pip libeigen3-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv && /venv/bin/pip install -q scikit-build-core "pybind11>=2.11,<3" numpy wheel setuptools
